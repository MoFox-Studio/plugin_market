PLUGIN_MARKET_ENV=production
PLUGIN_MARKET_DATABASE_URL=postgresql+asyncpg://plugin_market:plugin_market@postgres:5432/plugin_market
PLUGIN_MARKET_STORAGE_DIR=/app/data
PLUGIN_MARKET_ADMIN_TOKEN=change-me-admin-token
PLUGIN_MARKET_AUTHOR_TOKEN=change-me-author-token
PLUGIN_MARKET_GITHUB_WEBHOOK_SECRET=change-me-webhook-secret
PLUGIN_MARKET_GITHUB_OAUTH_CLIENT_ID=
PLUGIN_MARKET_GITHUB_OAUTH_CLIENT_SECRET=
PLUGIN_MARKET_GITHUB_OAUTH_REDIRECT_URI=https://market.example.com/api/v1/auth/github/callback
PLUGIN_MARKET_SESSION_SECRET=change-me-session-secret
PLUGIN_MARKET_ADMIN_GITHUB_LOGINS=["your-github-login"]
PLUGIN_MARKET_REQUIRE_REVIEW=false
PLUGIN_MARKET_SEED_DEMO_DATA=false
PLUGIN_MARKET_CREATE_TABLES_ON_STARTUP=true
